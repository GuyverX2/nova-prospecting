### Nova prospecting — environment reference
#
# Every variable Nova reads is listed here with its default. Values shown are
# safe development defaults; production overrides are marked. Nova validates
# this configuration at startup and refuses to boot on an unsafe combination
# (see services/api/app/core/config.py and `GET /health/ready`).
#
# Never commit real secrets. On a host, keep this file at 0600.

## --- Runtime ---------------------------------------------------------------
# development | test | production
NOVA_ENV=development
NOVA_LOG_LEVEL=INFO
# json (machine-readable, recommended) | text
NOVA_LOG_FORMAT=json

## --- Database --------------------------------------------------------------
# SQLite is fine for local work and a single-node pilot. Use PostgreSQL for
# anything with concurrent workers, e.g.
#   postgresql+psycopg://nova:password@localhost:5432/nova
NOVA_DATABASE_URL=sqlite:///./nova.db
# Connection pool (ignored for SQLite).
NOVA_DB_POOL_SIZE=5
NOVA_DB_MAX_OVERFLOW=10
NOVA_DB_POOL_RECYCLE_SECONDS=1800
# Create tables from the models at startup. Defaults to false in production,
# where the schema must come from `alembic upgrade head`.
NOVA_DB_AUTO_CREATE=true

## --- Authentication --------------------------------------------------------
# HS256 secret shared with the platform that issues tokens. Required in
# production: at least 32 characters and never the development default.
# It also keys the HMAC opt-out links, so rotating it invalidates them.
NOVA_JWT_SECRET=replace-with-a-32-byte-or-longer-secret
NOVA_JWT_AUDIENCE=nova
# Clock skew tolerance in seconds (0-300).
NOVA_JWT_LEEWAY_SECONDS=10

## --- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API. Leave empty when the
# console is served from the same origin (the default deployment). Never '*'
# in production.
NOVA_CORS_ALLOW_ORIGINS=
# Built console to serve at '/'. Empty disables static hosting.
NOVA_SPA_DIST_DIR=apps/nova/dist

## --- SalesOS CRM boundary --------------------------------------------------
# Nova's only outbound platform dependency: POST /api/v1/nova/prospects/promote.
# Unset means promotion fails closed and local state stays unchanged.
SALESOS_CRM_BASE_URL=
SALESOS_CRM_TIMEOUT_SECONDS=5

## --- Website analysis ------------------------------------------------------
# Kill switch for fetching operator-selected public URLs. With it off, only
# pasted HTML snapshots can be analysed. Private/reserved/metadata addresses
# and non-web ports are always blocked, and robots.txt is honoured.
PROSPECTING_FETCH_ENABLED=false
# Public origin used to build share and opt-out links. Must be https when real
# email is enabled.
PROSPECTING_PUBLIC_BASE_URL=http://localhost:8000
# Optional Lighthouse enrichment. Analyses still work without it.
PAGESPEED_API_KEY=
PAGESPEED_TIMEOUT_SECONDS=25

## --- Discovery -------------------------------------------------------------
# manual | google_places | disabled. google_places requires the API key.
PROSPECTING_DISCOVERY_PROVIDER=manual
GOOGLE_PLACES_API_KEY=

## --- Outbound email --------------------------------------------------------
# Master kill switch. While false, nothing can leave the building: queue and
# mock providers only record state.
PROSPECTING_REAL_EMAIL_ENABLED=false
# queue | mock | resend | smtp_generic | disabled
PROSPECTING_EMAIL_PROVIDER=queue

# -- resend
PROSPECTING_EMAIL_API_KEY=
PROSPECTING_EMAIL_FROM=

# -- smtp_generic: one relay, up to 8 allowlisted sender mailboxes.
# A mailbox needs both ADDRESS and PASSWORD; a half-configured pair is refused.
PROSPECTING_SMTP_HOST=
PROSPECTING_SMTP_PORT=587
PROSPECTING_SMTP_STARTTLS=true
PROSPECTING_SMTP_TIMEOUT_SECONDS=20
PROSPECTING_SMTP_MAILBOX_1_ADDRESS=
PROSPECTING_SMTP_MAILBOX_1_PASSWORD=
PROSPECTING_SMTP_MAILBOX_2_ADDRESS=
PROSPECTING_SMTP_MAILBOX_2_PASSWORD=

## --- Rate limits (per tenant, per minute, 0 disables) ----------------------
# In-process limits: a multi-worker deployment gets this budget per worker.
PROSPECTING_ANALYSIS_RATE_LIMIT_PER_MINUTE=20
PROSPECTING_DISCOVERY_RATE_LIMIT_PER_MINUTE=10
PROSPECTING_DELIVERY_RATE_LIMIT_PER_MINUTE=30

## --- Scheduling ------------------------------------------------------------
# Nova runs nothing unattended. The flag is reported in the policy contract so
# operators can see that; enabling it does not start any background job.
NOVA_AGENT_SCHEDULER_ENABLED=false

## --- Frontend build --------------------------------------------------------
# Only needed to point the console at a different origin than the one serving
# it. Default is the same-origin path /api/v1.
VITE_NOVA_API_URL=
